---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Image } from "astro:assets";
import Container from "../components/Container.astro";
import avatar from "../assets/avatar.png";
import "../styles/global.css";

interface Props {
	title?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, description, image, canonical, robots, type = "website", publishedTime, modifiedTime, content } = Astro.props;

const [settingsResult, menuResult] = await Promise.all([getSiteSettingsWithCacheHint(), getMenuWithCacheHint("primary")]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}
const siteTitle = settingsResult.data?.title ?? "询盘自由网";
const siteTagline = settingsResult.data?.tagline ?? "";
const menuItems = menuResult.data?.items ?? [];

const fullTitle = title ? `${title} - ${siteTitle}` : `${siteTitle} - ${siteTagline}`;
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description ?? siteTagline,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author: "颜sir" },
	siteName: siteTitle,
});

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = path === "/";
const isActive = (url: string) => url.startsWith("/") && (url.replace(/\/$/, "") || "/") === path;
const linkAttrs = (target?: string | null) => (target === "_blank" ? { target: "_blank", rel: "noopener" } : {});
const year = new Date().getFullYear();

const glass =
	"bg-white/90 shadow-lg shadow-zinc-800/5 ring-1 ring-zinc-900/5 backdrop-blur-sm dark:bg-zinc-800/90 dark:ring-white/10";
---

<!doctype html>
<html lang="zh-CN" class="h-full antialiased">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS`} href="/feed.xml" />
		<link rel="icon" href="/favicon.ico" />
		<EmDashHead page={pageCtx} />
		<script is:inline>
			// Theme: stored choice wins, otherwise follow the OS (next-themes "system" parity).
			(function () {
				var t = localStorage.getItem("theme");
				var dark = t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle("dark", dark);
			})();
		</script>
	</head>
	<body class="flex h-full bg-zinc-50 dark:bg-black">
		<EmDashBodyStart page={pageCtx} />
		<div class="flex w-full">
			<div class="fixed inset-0 flex justify-center sm:px-8">
				<div class="flex w-full max-w-7xl lg:px-8">
					<div class="w-full bg-white ring-1 ring-zinc-100 dark:bg-zinc-900 dark:ring-zinc-300/20"></div>
				</div>
			</div>
			<div class="relative flex w-full flex-col">
				<header
					id="site-header"
					class="pointer-events-none relative z-50 flex flex-none flex-col"
					data-home={isHome}
					style="height: var(--header-height); margin-bottom: var(--header-mb)"
				>
					{
						isHome && (
							<>
								<div data-avatar-anchor class="order-last mt-[calc(--spacing(16)-(--spacing(3)))]" />
								<Container class="top-0 order-last -mb-3 pt-3" style="position: var(--header-position)">
									<div class="top-(--avatar-top,--spacing(3)) w-full" style="position: var(--header-inner-position)">
										<div class="relative">
											<div
												data-avatar-border
												class:list={["absolute top-3 left-0 h-10 w-10 origin-left rounded-full p-0.5 transition-opacity", glass]}
												style="opacity: var(--avatar-border-opacity, 0); transform: var(--avatar-border-transform)"
											/>
											<a href="/" aria-label="Home" class="pointer-events-auto block h-16 w-16 origin-left" style="transform: var(--avatar-image-transform)">
												<Image src={avatar} alt="" widths={[64, 128]} sizes="4rem" class="h-16 w-16 rounded-full bg-zinc-100 object-cover dark:bg-zinc-800" loading="eager" />
											</a>
										</div>
									</div>
								</Container>
							</>
						)
					}
					<div data-header-bar class="top-0 z-10 h-16 pt-6" style="position: var(--header-position)">
						<Container class="top-(--header-top,--spacing(6)) w-full" style="position: var(--header-inner-position)">
							<div class="relative flex gap-4">
								<div class="flex flex-1">
									{
										!isHome && (
											<div class:list={["h-10 w-10 rounded-full p-0.5", glass]}>
												<a href="/" aria-label="Home" class="pointer-events-auto">
													<Image src={avatar} alt="" widths={[36, 72]} sizes="2.25rem" class="h-9 w-9 rounded-full bg-zinc-100 object-cover dark:bg-zinc-800" loading="eager" />
												</a>
											</div>
										)
									}
								</div>
								<div class="flex flex-2 justify-end md:justify-center">
									<div class="pointer-events-auto md:hidden">
										<button type="button" data-menu-open class:list={["group flex items-center rounded-full px-4 py-2 text-sm font-medium text-zinc-800 dark:text-zinc-200 dark:hover:ring-white/20", glass]}>
											菜单
											<svg viewBox="0 0 8 6" aria-hidden="true" class="ml-3 h-auto w-2 stroke-zinc-500 group-hover:stroke-zinc-700 dark:group-hover:stroke-zinc-400">
												<path d="M1.75 1.75 4 4.25l2.25-2.5" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
										</button>
									</div>
									<nav class="pointer-events-auto hidden md:block">
										<ul class:list={["flex rounded-full px-3 text-sm font-medium text-zinc-800 dark:text-zinc-200", glass]}>
											{
												menuItems.map((item) => (
													<li>
														<a
															href={item.url}
															{...linkAttrs(item.target)}
															class:list={["relative block px-3 py-2 transition", isActive(item.url) ? "text-indigo-500 dark:text-indigo-400" : "hover:text-indigo-500 dark:hover:text-indigo-400"]}
														>
															{item.label}
															{isActive(item.url) && <span class="absolute inset-x-1 -bottom-px h-px bg-linear-to-r from-indigo-500/0 via-indigo-500/40 to-indigo-500/0 dark:from-indigo-400/0 dark:via-indigo-400/40 dark:to-indigo-400/0" />}
														</a>
													</li>
												))
											}
										</ul>
									</nav>
								</div>
								<div class="flex justify-end md:flex-1">
									<div class="pointer-events-auto">
										<button type="button" data-theme-toggle aria-label="切换主题" class:list={["group rounded-full px-3 py-2 transition dark:hover:ring-white/20", glass]}>
											<svg viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-6 w-6 fill-zinc-100 stroke-zinc-500 transition group-hover:fill-zinc-200 group-hover:stroke-zinc-700 dark:hidden">
												<path d="M8 12.25A4.25 4.25 0 0 1 12.25 8v0a4.25 4.25 0 0 1 4.25 4.25v0a4.25 4.25 0 0 1-4.25 4.25v0A4.25 4.25 0 0 1 8 12.25v0Z" />
												<path d="M12.25 3v1.5M21.5 12.25H20M18.791 18.791l-1.06-1.06M18.791 5.709l-1.06 1.06M12.25 20v1.5M4.5 12.25H3M6.77 6.77 5.709 5.709M6.77 17.73l-1.061 1.061" fill="none" />
											</svg>
											<svg viewBox="0 0 24 24" aria-hidden="true" class="hidden h-6 w-6 fill-zinc-700 stroke-zinc-500 transition group-hover:stroke-zinc-400 dark:block">
												<path d="M17.25 16.22a6.937 6.937 0 0 1-9.47-9.47 7.451 7.451 0 1 0 9.47 9.47ZM12.75 7C17 7 17 2.75 17 2.75S17 7 21.25 7C17 7 17 11.25 17 11.25S17 7 12.75 7Z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
										</button>
									</div>
								</div>
							</div>
						</Container>
					</div>
				</header>
				{isHome && <div class="flex-none" style="height: var(--content-offset)" />}

				<div id="menu-backdrop" hidden class="fixed inset-0 z-50 bg-zinc-800/40 backdrop-blur-xs dark:bg-black/80"></div>
				<div id="menu-panel" hidden role="dialog" aria-modal="true" aria-label="导航" class="fixed inset-x-4 top-8 z-50 origin-top rounded-3xl bg-white p-8 ring-1 ring-zinc-900/5 dark:bg-zinc-900 dark:ring-zinc-800">
					<div class="flex flex-row-reverse items-center justify-between">
						<button type="button" data-menu-close aria-label="Close menu" class="-m-1 p-1">
							<svg viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 text-zinc-500 dark:text-zinc-400">
								<path d="m17.25 6.75-10.5 10.5M6.75 6.75l10.5 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<h2 class="text-sm font-medium text-zinc-600 dark:text-zinc-400">导航</h2>
					</div>
					<nav class="mt-6">
						<ul class="-my-2 divide-y divide-zinc-100 text-base text-zinc-800 dark:divide-zinc-100/5 dark:text-zinc-300">
							{menuItems.map((item) => <li><a href={item.url} {...linkAttrs(item.target)} class="block py-2">{item.label}</a></li>)}
						</ul>
					</nav>
				</div>

				<main id="main" class="flex-auto"><slot /></main>

				<footer class="mt-32 flex-none">
					<div class="sm:px-8">
						<div class="mx-auto w-full max-w-7xl lg:px-8">
							<div class="border-t border-zinc-100 pt-10 pb-16 dark:border-zinc-700/40">
								<div class="relative px-4 sm:px-8 lg:px-12">
									<div class="mx-auto max-w-2xl lg:max-w-5xl">
										<div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
											<div class="flex flex-wrap justify-center gap-x-6 gap-y-1 text-sm font-medium text-zinc-800 dark:text-zinc-200">
												{menuItems.map((item) => <a href={item.url} {...linkAttrs(item.target)} class="transition hover:text-indigo-500 dark:hover:text-indigo-400">{item.label}</a>)}
											</div>
											<p class="text-sm text-zinc-400 dark:text-zinc-500">
												&copy; {year} 网站所有权归 <a href="https://www.imiker.com" target="_blank" rel="noopener" class="hover:font-medium">南京米课网络信息技术有限公司</a> 所有
											</p>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</footer>
			</div>
		</div>
		<EmDashBodyEnd page={pageCtx} />
		<script>
			const root = document.documentElement;
			const set = (k: string, v: string) => root.style.setProperty(k, v);
			const clamp = (n: number, a: number, b: number) => Math.min(Math.max(n, Math.min(a, b)), Math.max(a, b));

			// Theme toggle
			document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
				const dark = !root.classList.contains("dark");
				root.classList.toggle("dark", dark);
				localStorage.setItem("theme", dark ? "dark" : "light");
			});

			// Mobile menu
			const panel = document.getElementById("menu-panel")!;
			const backdrop = document.getElementById("menu-backdrop")!;
			const toggleMenu = (open: boolean) => {
				panel.hidden = backdrop.hidden = !open;
			};
			document.querySelector("[data-menu-open]")?.addEventListener("click", () => toggleMenu(true));
			document.querySelector("[data-menu-close]")?.addEventListener("click", () => toggleMenu(false));
			backdrop.addEventListener("click", () => toggleMenu(false));
			panel.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => toggleMenu(false)));
			addEventListener("keydown", (e) => e.key === "Escape" && toggleMenu(false));

			// Sticky header + shrinking home avatar (Spotlight scroll choreography)
			const header = document.getElementById("site-header")!;
			const bar = header.querySelector<HTMLElement>("[data-header-bar]")!;
			const anchor = header.querySelector<HTMLElement>("[data-avatar-anchor]");
			const isHome = header.dataset.home === "true";
			const downDelay = anchor?.offsetTop ?? 0;
			const upDelay = 64;
			let initial = true;

			function updateHeader() {
				const { top, height } = bar.getBoundingClientRect();
				const scrollY = clamp(window.scrollY, 0, document.body.scrollHeight - window.innerHeight);
				if (initial) set("--header-position", "sticky");
				set("--content-offset", `${downDelay}px`);
				if (initial || scrollY < downDelay) {
					set("--header-height", `${downDelay + height}px`);
					set("--header-mb", `${-downDelay}px`);
				} else if (top + height < -upDelay) {
					const offset = Math.max(height, scrollY - upDelay);
					set("--header-height", `${offset}px`);
					set("--header-mb", `${height - offset}px`);
				} else if (top === 0) {
					set("--header-height", `${scrollY + height}px`);
					set("--header-mb", `${-scrollY}px`);
				}
				if (top === 0 && scrollY > 0 && scrollY >= downDelay) {
					set("--header-inner-position", "fixed");
					root.style.removeProperty("--header-top");
					root.style.removeProperty("--avatar-top");
				} else {
					root.style.removeProperty("--header-inner-position");
					set("--header-top", "0px");
					set("--avatar-top", "0px");
				}
			}

			function updateAvatar() {
				if (!isHome) return;
				const fromScale = 1, toScale = 36 / 64, fromX = 0, toX = 2 / 16;
				const y = downDelay - window.scrollY;
				const scale = clamp((y * (fromScale - toScale)) / downDelay + toScale, fromScale, toScale);
				const x = clamp((y * (fromX - toX)) / downDelay + toX, fromX, toX);
				set("--avatar-image-transform", `translate3d(${x}rem, 0, 0) scale(${scale})`);
				const borderScale = 1 / (toScale / scale);
				set("--avatar-border-transform", `translate3d(${(-toX + x) * borderScale}rem, 0, 0) scale(${borderScale})`);
				set("--avatar-border-opacity", scale === toScale ? "1" : "0");
			}

			function update() {
				updateHeader();
				updateAvatar();
				initial = false;
			}
			update();
			addEventListener("scroll", update, { passive: true });
			addEventListener("resize", update);
		</script>
	</body>
</html>
