---
import ArticleCard from "./ArticleCard.astro";
import Pagination from "./Pagination.astro";
import type { ArticleMeta } from "../lib/site-index";

interface Props {
	items: ArticleMeta[];
	page: number;
	totalPages: number;
	basePath: string;
	/** Show the chapter number above each card (sequential collections). */
	numbered?: boolean;
}
const { items, page, totalPages, basePath, numbered = false } = Astro.props;
---

<div class="md:border-l md:border-zinc-100 md:pl-6 md:dark:border-zinc-700/40">
	<div class="flex max-w-3xl flex-col space-y-16">
		{
			items.map((a) => (
				<div>
					{numbered && a.chapter !== undefined && <p class="mb-2 text-sm font-medium text-indigo-500">第 {a.chapter} 章</p>}
					<ArticleCard layout="list" href={`/articles/${a.slug}`} title={a.title} description={a.description} date={a.date} />
				</div>
			))
		}
	</div>
</div>
<Pagination page={page} totalPages={totalPages} basePath={basePath} />
