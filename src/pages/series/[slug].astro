---
import Base from "../../layouts/Base.astro";
import SimpleLayout from "../../components/SimpleLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getSeriesChapters } from "../../lib/series";
import { isSeries, series } from "../../consts/series";

const slug = Astro.params.slug;
if (!isSeries(slug)) return Astro.rewrite("/404");

const { chapters, cacheHint } = await getSeriesChapters(slug);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const meta = series[slug];
---

<Base title={meta.title} description={meta.description}>
	<SimpleLayout title={meta.title} intro={meta.description}>
		<div class="md:border-l md:border-zinc-100 md:pl-6 md:dark:border-zinc-700/40">
			<ol class="flex max-w-3xl flex-col space-y-16">
				{
					chapters.map((a, i) => (
						<li>
							<p class="mb-2 text-sm font-medium text-indigo-500">第 {i + 1} 章</p>
							<ArticleCard layout="stacked" href={`/articles/${a.id}`} title={a.data.title} description={a.data.excerpt} date={a.data.publishedAt!} />
						</li>
					))
				}
			</ol>
		</div>
	</SimpleLayout>
</Base>
