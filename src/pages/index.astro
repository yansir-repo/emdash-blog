---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import SimpleH2Layout from "../components/SimpleH2Layout.astro";
import AffCards from "../components/AffCards.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Newsletter from "../components/Newsletter.astro";
import FeaturedCollections from "../components/FeaturedCollections.astro";
import { articles } from "../lib/site-index";
import SocialIcon from "../components/SocialIcon.astro";
import image1 from "../assets/photos/image-1.jpg";
import image2 from "../assets/photos/image-2.jpg";
import image3 from "../assets/photos/image-3.jpg";
import image4 from "../assets/photos/image-4.jpg";
import image5 from "../assets/photos/image-5.jpg";

const latest = articles.slice(0, 4);

const photos = [image1, image2, image3, image4, image5];
const rotations = ["rotate-2", "-rotate-2", "rotate-2", "rotate-2", "-rotate-2"];
const social = [
	{ name: "wechat", label: "Follow on Wechat" },
	{ name: "tiktok", label: "Follow on Tiktok" },
	{ name: "xiaohongshu", label: "Follow on Xiaohongshu" },
	{ name: "github", label: "Follow on Github" },
] as const;
---

<Base>
	<Container class="mt-9">
		<div class="max-w-2xl">
			<h1 class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">询盘自由网</h1>
			<p class="mt-6 text-base text-zinc-600 dark:text-zinc-400">
				我是颜sir，一个专注于技术的人。我喜欢阅读技术相关的书籍和文章，也喜欢分享自己的经验和见解。我也喜欢创作和分享自己的作品。
				我也喜欢和朋友交流技术问题和分享自己的经验。
			</p>
			<div class="mt-6 flex gap-6">
				{
					social.map((s) => (
						<a href="#" aria-label={s.label} class="group -m-1 h-6 w-6 p-1 grayscale filter transition-colors duration-300 hover:filter-none dark:text-zinc-100">
							<SocialIcon name={s.name} class="h-6 w-6 fill-zinc-500 transition group-hover:fill-zinc-600 dark:fill-zinc-400 dark:group-hover:fill-zinc-300" />
						</a>
					))
				}
			</div>
		</div>
	</Container>

	<div class="mt-16 sm:mt-20">
		<div class="-my-4 flex justify-center gap-5 overflow-hidden py-4 sm:gap-8">
			{
				photos.map((photo, i) => (
					<div class:list={["relative aspect-9/10 w-44 flex-none overflow-hidden rounded-xl bg-zinc-100 sm:w-72 sm:rounded-2xl dark:bg-zinc-800", rotations[i]]}>
						<Image src={photo} alt="" widths={[176, 288, 576]} sizes="(min-width: 640px) 18rem, 11rem" class="absolute inset-0 h-full w-full object-cover" />
					</div>
				))
			}
		</div>
	</div>

	<SimpleH2Layout title="精选合集" description="按主题把文章串起来：想系统学一件事，从这里挑一条路径走下去。">
		<FeaturedCollections />
	</SimpleH2Layout>

	<SimpleH2Layout title="严选工具" description="下面都是我用过的工具，每一个都经过十几轮试错，大浪淘沙剩下来的。">
		<AffCards />
	</SimpleH2Layout>

	<SimpleH2Layout title="最新文章" description="下面是我最新文章，每篇都算得上呕心沥血，希望你也能有所收获。">
		<div class="mx-auto grid max-w-xl grid-cols-1 gap-y-20 lg:max-w-none lg:grid-cols-2">
			<div class="flex flex-col gap-16">
				{
					latest.map((a) => (
						<ArticleCard href={`/articles/${a.slug}`} title={a.title} description={a.description} date={a.date} />
					))
				}
			</div>
			<div class="max-w-[450px] space-y-10 lg:pl-16 xl:pl-24">
				<Newsletter />
			</div>
		</div>
	</SimpleH2Layout>
</Base>
