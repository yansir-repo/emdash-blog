{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-blog",
			"database_id": "f0866ea7-bf06-4614-8608-aa722b80f87f",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-blog-media",
		},
	],
	// Production hostnames (Custom Domains manage their own DNS records and certificates).
	// www is canonical (astro.config.mjs `site`); the apex redirects to it in src/middleware.ts.
	// Production is served only on the custom domains below: no workers.dev address, no per-version preview URLs.
	// (The admin passkey lives on www; see README, Domain.)
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "www.xunpanziyou.com", "custom_domain": true },
		{ "pattern": "xunpanziyou.com", "custom_domain": true },
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
